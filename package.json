{
  "name": "itemd",
  "version": "1.0.0",
  "description": "An explicit, replayable TypeScript coding-agent harness.",
  "main": "main.ts",
  "scripts": {
    "start": "node --env-file=.env main.ts",
    "tui": "node --env-file=.env src/ui/tui.ts",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatShashankGuy/itemD.git"
  },
  "bugs": {
    "url": "https://github.com/thatShashankGuy/itemD/issues"
  },
  "homepage": "https://github.com/thatShashankGuy/itemD#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
