{
  "name": "itemd",
  "version": "0.1.8",
  "description": "An explicit, replayable TypeScript coding-agent harness.",
  "main": "main.ts",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --experimental-ffi --env-file-if-exists=.env main.ts",
    "tui": "npm start",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatShashankGuy/itemd.git"
  },
  "bugs": {
    "url": "https://github.com/thatShashankGuy/itemd/issues"
  },
  "homepage": "https://github.com/thatShashankGuy/itemd#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@opentui/core": "^0.8.3",
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
